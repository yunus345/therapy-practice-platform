# Copy to .env (`make up` does this if it is missing).
# Placeholders containing "change-me" are accepted only when ENVIRONMENT=dev.

# Runtime environment: dev, test or production. Unset means production.
ENVIRONMENT=dev

# --- Docker Compose (local Postgres) ---
# Superuser, owner of the schema, used by migrations.
POSTGRES_USER=seans_owner
POSTGRES_PASSWORD=change-me-owner-password
# Main development database.
POSTGRES_DB=seans
# Separate database used by the test suite.
POSTGRES_TEST_DB=seans_test
# Restricted role used by the application at runtime.
APP_DB_USER=seans_app
APP_DB_PASSWORD=change-me-app-password

# --- Application ---
# Runtime connection, restricted role. Required.
DATABASE_URL=postgresql+asyncpg://seans_app:change-me-app-password@localhost:5432/seans
# Migration connection, owner role. Required.
MIGRATION_DATABASE_URL=postgresql+asyncpg://seans_owner:change-me-owner-password@localhost:5432/seans
# Test suite connection, restricted role. Required only to run tests.
TEST_DATABASE_URL=postgresql+asyncpg://seans_app:change-me-app-password@localhost:5432/seans_test

# Signs CSRF tokens. At least 32 characters. Required.
# Generate with: openssl rand -base64 48
CSRF_SECRET=change-me-generate-a-random-value
# Encrypts TOTP secrets at rest. At least 32 characters. Required.
# Generate with: openssl rand -base64 48
TOTP_ENCRYPTION_KEY=change-me-generate-a-random-value

# Blocks staff panel access until 2FA is enabled. The app refuses to start in
# production when this is false.
REQUIRE_STAFF_2FA=false
